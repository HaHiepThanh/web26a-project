# Chép file này thành `secrets/.env` (ở GỐC dự án, KHÔNG phải trong backend/)
# rồi điền giá trị thật.
#
#     cp backend/.env.example secrets/.env
#
# Cách lấy từng khoá: docs/LAY-CAC-KEY.md
#
# ⚠️ MỌI biến nằm ở MỘT file duy nhất `secrets/.env`. Trước đây chúng rải ở hai
#    nơi và đã gây đúng một lỗi: đặt khoá vào `secrets/.env` rồi tưởng xong, mà
#    backend chỉ đọc `backend/.env` nên không hề thấy.
#
# ⚠️ Để TRỐNG một dòng nghĩa là "chưa đặt" — đó là cách đúng để bỏ qua một biến.
#    Đừng xoá hẳn dòng, để người sau còn biết là có biến đó.


# --------------------------------------------------------------------------
# SUPABASE — database + lưu trữ tệp
# --------------------------------------------------------------------------
# ⚠️ service_role BỎ QUA TOÀN BỘ RLS: ai cầm được nó là đọc/sửa được dữ liệu của
#    mọi tổ chức mà không cần đăng nhập. CHỈ dùng ở backend, không đưa ra frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY


# --------------------------------------------------------------------------
# FIREBASE — xác thực
# --------------------------------------------------------------------------
# Đường dẫn tính từ thư mục chạy lệnh npm, tức backend/.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/ten-file-service-account.json

# Cách thay thế, khi nơi deploy chỉ cho đặt biến chứ không cho đặt file:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# --------------------------------------------------------------------------
# GEMINI — gợi ý tạo thẻ
# --------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


# --------------------------------------------------------------------------
# GEMINI — kiểm duyệt ảnh 18+ (khoá RIÊNG, project KHÁC)
# --------------------------------------------------------------------------
# Gemini một mình phủ đủ 9 nhóm: khiêu dâm, gợi dục, bạo lực, máu me, vũ khí,
# ma tuý, biểu tượng thù ghét, tự hại, gây sốc.
#
# Nên dùng khoá riêng thuộc PROJECT KHÁC: chung khoá thì kiểm duyệt ảnh và gợi
# ý tạo thẻ ăn chung một hạn mức tần suất, và đã đo được thật là gợi ý thẻ bắt
# đầu chạm timeout khi có nhiều lượt tải ảnh.
#
# Để trống thì tự rơi về GEMINI_API_KEY ở trên.
MODERATION_GEMINI_API_KEY=
MODERATION_GEMINI_MODEL=

# Để trống = tự BẬT khi có ít nhất một khoá. Đặt 'false' để tắt hẳn.
MODERATION_ENABLED=


# --------------------------------------------------------------------------
# CLOUD VISION — TUỲ CHỌN, đọc kỹ trước khi điền
# --------------------------------------------------------------------------
# 🛑 Cloud Vision BẮT BUỘC bật thanh toán trên Google Cloud. Chưa bật thì mọi
#    lời gọi trả 403, và vì hệ thống chạy fail-closed, MỌI UPLOAD ẢNH SẼ BỊ
#    CHẶN — kể cả khi Gemini vẫn chạy tốt.
#
#    Thử khoá bằng lệnh curl ở docs/LAY-CAC-KEY.md (Bước 0') TRƯỚC khi điền.
#    Không có nó vẫn đủ tính năng; nó chỉ thêm độ chính xác và bớt độ trễ.
GOOGLE_VISION_API_KEY=


# --------------------------------------------------------------------------
# SMTP — gửi email đặt lại mật khẩu
# --------------------------------------------------------------------------
# CHƯA ĐẶT thì backend KHÔNG gửi được email, và app tự quay về đường gửi mail
# của Firebase — vẫn đặt lại được mật khẩu, nhưng người dùng thấy trang dựng sẵn
# của Firebase thay vì trang của app.
#
# VÌ SAO PHẢI TỰ GỬI: liên kết trong email của Firebase trỏ tới
# `<project>.firebaseapp.com/__/auth/action`. Vùng `/__/` do Firebase Hosting tự
# phục vụ nên rewrite không chạm tới được, và Action URL của dự án này KHÔNG sửa
# được (Console lẫn Admin API đều trả EMAIL_TEMPLATE_UPDATE_NOT_ALLOWED).
# Backend sinh link bằng Admin SDK, tách oobCode rồi tự gửi thư trỏ về app.
#
# Với Gmail: bật xác minh 2 bước rồi tạo "App password" 16 ký tự tại
# https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --------------------------------------------------------------------------
# BACKEND
# --------------------------------------------------------------------------
PORT=3000
