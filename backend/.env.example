# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Supabase (backend dùng service_role -> bỏ qua RLS, giữ bí mật tuyệt đối)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Firebase Admin (verify ID token). Lấy từ service account JSON của Firebase.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Claude API — CHƯA CẦN. Tính năng "AI gợi ý tạo thẻ" đang tạm tắt (AiModule
# đã comment trong src/app.module.ts). Khi nào làm tới thì mới cần điền.
# ANTHROPIC_API_KEY=sk-ant-...

# Cổng chạy backend
PORT=3000
