# Sao chép file này thành backend/.env (hoặc secrets/.env) rồi điền giá trị thật.
# KHÔNG commit file đã điền — .env nằm trong .gitignore.
# Xem docs/LAY-CAC-KEY.md để biết lấy từng khoá ở đâu.

PORT=3000

# ── Supabase ────────────────────────────────────────────────────────────────
# SERVICE_ROLE bỏ qua RLS hoàn toàn: mọi kiểm tra quyền do code backend làm.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase Admin (xác minh ID token) ──────────────────────────────────────
# Đường dẫn tới file service-account JSON tải từ Firebase Console.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Gemini: AI gợi ý tạo thẻ từ tin nhắn ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Gemini Vision: kiểm duyệt ảnh tải lên ───────────────────────────────────
MODERATION_ENABLED=true
MODERATION_GEMINI_API_KEY=
MODERATION_GEMINI_MODEL=

# ── Email giao dịch (đặt lại mật khẩu, lời mời) ─────────────────────────────
# Ưu tiên Brevo qua HTTPS. Railway chặn cổng SMTP ra ngoài ở gói thấp,
# nên SMTP_* chỉ dùng khi chạy dưới máy hoặc trên host không chặn.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
