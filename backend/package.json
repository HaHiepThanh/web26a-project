{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "kiem-tra:huy": "python3 scripts/kiem-tra-huy.py",
    "kiem-tra:hoa": "python3 scripts/kiem-tra-hoa.py",
    "kiem-tra:hoang": "python3 scripts/kiem-tra-hoang.py",
    "kiem-tra:websocket": "node scripts/kiem-tra-websocket.mjs",
    "kiem-tra": "npm run kiem-tra:huy && npm run kiem-tra:hoa && npm run kiem-tra:hoang && npm run kiem-tra:websocket && npm run kiem-tra:pham-vi && npm run kiem-tra:bo-sung && npm run kiem-tra:ai && npm run kiem-tra:bao-mat && npm run kiem-tra:link-moi && npm run kiem-tra:chong-xam-nhap && npm run kiem-tra:lich-hop && npm run kiem-tra:kiem-duyet-anh && npm run kiem-tra:nhap-lich",
    "kiem-tra:pham-vi": "node scripts/kiem-tra-pham-vi.mjs",
    "kiem-tra:bo-sung": "node scripts/kiem-tra-bo-sung.mjs",
    "kiem-tra:ai": "node scripts/kiem-tra-ai.mjs",
    "kiem-tra:bao-mat": "node scripts/kiem-tra-bao-mat.mjs",
    "kiem-tra:link-moi": "node scripts/kiem-tra-link-moi.mjs",
    "kiem-tra:chong-xam-nhap": "node scripts/kiem-tra-chong-xam-nhap.mjs",
    "kiem-tra:lich-hop": "node scripts/kiem-tra-lich-hop.mjs",
    "kiem-tra:kiem-duyet-anh": "node scripts/kiem-tra-kiem-duyet-anh.mjs",
    "kiem-tra:nhap-lich": "node scripts/kiem-tra-nhap-lich.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "@supabase/supabase-js": "^2.110.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.2.0",
    "node-ical": "^0.27.1",
    "nodemailer": "^9.0.6",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jose|@panva/hkdf)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
